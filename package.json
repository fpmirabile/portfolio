{
  "name": "portfolio",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "oxlint .",
    "format": "oxfmt . && prettier --plugin prettier-plugin-astro --write 'src/**/*.astro'",
    "format:check": "oxfmt --check . && prettier --plugin prettier-plugin-astro --check 'src/**/*.astro'",
    "skills:update": "pnpm dlx skills update --project --yes"
  },
  "dependencies": {
    "@lucide/astro": "^1.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  }
}

---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  lang: string;
  redirectTo?: string;
}

const { title, description, lang, redirectTo } = Astro.props;
const canonical = new URL(redirectTo ?? Astro.url.pathname, Astro.site).href;
const languageAlternates = ["es", "en", "pt"];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#f8f7f3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!redirectTo &&
      languageAlternates.map((language) => (
        <link
          rel="alternate"
          hreflang={language}
          href={new URL(`/${language}/`, Astro.site).href}
        />
      ))}
    {!redirectTo && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL("/en/", Astro.site).href}
      />
    )}
    {redirectTo && (
      <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      document.documentElement.classList.toggle(
        "dark",
        savedTheme
          ? savedTheme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches,
      );
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute(
          "content",
          document.documentElement.classList.contains("dark")
            ? "#202723"
            : "#f8f7f3",
        );
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
  </body>
</html>

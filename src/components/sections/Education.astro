---
import type { Certification, EducationTexts } from "../../types";
import CollectionDialog from "../common/CollectionDialog.astro";

interface Props { texts: EducationTexts; certifications: Certification[]; closeText: string; }
const { texts, certifications, closeText } = Astro.props;
const recent = certifications.slice(0, 3);
const years = [...new Set(certifications.map((certification) => certification.year))];
---

<section id="education" class="border-t border-border py-16 sm:py-20" aria-labelledby="education-title">
  <div class="section-shell">
    <div class="mb-10 max-w-2xl">
      <p class="eyebrow mb-3">04</p>
      <h2 id="education-title" class="text-4xl font-semibold text-foreground sm:text-5xl">{texts.educationTitle}</h2>
      <p class="prose-lead mt-4">{texts.educationDesc}</p>
    </div>
    <div class="grid gap-5 lg:grid-cols-[minmax(0,.75fr)_minmax(0,1.25fr)]">
      <article class="surface-card p-7 sm:p-8">
        <p class="eyebrow">{texts.academicTitle}</p>
        <h3 class="mt-4 text-2xl font-semibold text-foreground">{texts.degree.name}</h3>
        <p class="mt-3 text-muted-foreground">{texts.degree.institution}</p>
        <p class="mt-8 border-t border-border pt-4 text-sm font-medium text-primary">{texts.degree.graduationDate}</p>
      </article>
      <div class="surface-card p-7 sm:p-8">
        <p class="eyebrow">{texts.certificationsTitle}</p>
        <div class="mt-4 divide-y divide-border">
          {recent.map((certification) => (
            <article class="py-4 first:pt-0">
              <h3 class="font-semibold text-foreground">{certification.name}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{certification.issuer} · {certification.year}</p>
            </article>
          ))}
        </div>
        <div class="mt-3 border-t border-border">
          <CollectionDialog id="certifications-dialog" title={texts.certificationsTitle} triggerText={texts.showAllText} {closeText} count={certifications.length}>
            <div class="space-y-7">
              {years.map((year) => (
                <section aria-label={String(year)}>
                  <p class="eyebrow mb-2">{year}</p>
                  <div class="divide-y divide-border">
                    {certifications.filter((certification) => certification.year === year).map((certification) => (
                      <article class="grid gap-1 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-5">
                        <h4 class="font-semibold text-foreground">{certification.name}</h4>
                        <p class="text-sm text-muted-foreground sm:text-right">{certification.issuer}</p>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </CollectionDialog>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { ArrowUpRight, Mail } from "@lucide/astro";

interface Props {
  invitation: string;
  contactText: string;
  backToTopText: string;
}
const { invitation, contactText, backToTopText } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="border-t border-border bg-secondary/35 py-16 sm:py-20">
  <div class="section-shell">
    <p class="eyebrow">05</p>
    <div class="mt-4 flex flex-col gap-7 border-b border-border pb-14 lg:flex-row lg:items-end lg:justify-between">
      <h2 class="max-w-3xl text-4xl font-semibold text-foreground sm:text-5xl">{invitation}</h2>
      <a href="mailto:fpmirabile@zohomail.eu" class="button-primary shrink-0"><Mail size={18} aria-hidden="true" />{contactText}</a>
    </div>
    <div class="flex flex-col gap-5 pt-7 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>© {currentYear} Fernando Mirabile · Porto, Portugal</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="https://www.linkedin.com/in/fernando-pablo-mirabile-viola-85a64a52" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1 hover:text-foreground">LinkedIn<ArrowUpRight size={14} aria-hidden="true" /></a>
        <a href="https://github.com/fpmirabile" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1 hover:text-foreground">GitHub<ArrowUpRight size={14} aria-hidden="true" /></a>
        <a href="#top" class="inline-flex min-h-11 items-center hover:text-foreground">{backToTopText}</a>
      </div>
    </div>
  </div>
</footer>
